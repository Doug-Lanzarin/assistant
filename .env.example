# Copie para .env e ajuste. NUNCA versione o .env.
# Preferência: cadastre chaves e tokens pela interface (Configurações → Segredos),
# onde ficam cifrados com DPAPI. As variáveis abaixo são uma alternativa.

JARVIS_ENV=production            # development | production
JARVIS_HOST=127.0.0.1            # não exponha à rede sem necessidade
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=INFO
# JARVIS_DATA_DIR=C:\Users\voce\AppData\Local\Jarvis   # padrão: ./data

# IA na nuvem (opcional)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Home Assistant (opcional)
# JARVIS_HA_URL=http://homeassistant.local:8123
# JARVIS_HA_TOKEN=
