# Variáveis de ambiente do JARVIS. O setup.bat copia este arquivo para .env
# (só se o .env ainda não existir) e nunca o sobrescreve. NUNCA versione o .env.
#
# Chaves e tokens: prefira cadastrá-los pela interface (Configurações → IA /
# Integrações), onde ficam cifrados com DPAPI. As variáveis abaixo são uma
# alternativa; se usar, o arquivo .env fica em texto puro no seu computador.
# Nenhum valor de chave é exibido pelo setup.bat nem gravado nos logs.

# --- Servidor ---------------------------------------------------------------
JARVIS_ENV=production            # development | production
JARVIS_HOST=127.0.0.1            # não exponha à rede (nem à internet)
JARVIS_PORT=8765                 # interface: http://127.0.0.1:8765/#/jarvis
JARVIS_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# JARVIS_LOG_CONSOLE=1           # logs também no terminal (o start.bat já liga)

# --- Pastas -----------------------------------------------------------------
# JARVIS_DATA_DIR=D:\JarvisDados   # padrão: .\data (banco, logs, segredos, backups, modelos)
# JARVIS_CONFIG_FILE=D:\JarvisDados\jarvis.toml   # padrão: .\config\jarvis.toml

# --- IA na nuvem (opcional) -------------------------------------------------
# A IA local (Ollama) é configurada em Configurações → IA (endereço e modelo).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Home Assistant (opcional) ----------------------------------------------
# JARVIS_HA_URL=http://homeassistant.local:8123
# JARVIS_HA_TOKEN=
